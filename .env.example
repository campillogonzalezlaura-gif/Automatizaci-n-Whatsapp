# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# WHATSAPP_TOKEN: Access token for WhatsApp Business API
WHATSAPP_TOKEN="YOUR_WHATSAPP_TOKEN"

# WHATSAPP_PHONE_NUMBER_ID: ID of the phone number sending messages
WHATSAPP_PHONE_NUMBER_ID="YOUR_PHONE_ID"

# WHATSAPP_VERIFY_TOKEN: Random string used to verify webhook in Meta dashboard
WHATSAPP_VERIFY_TOKEN="YOUR_CHOSEN_TOKEN"
